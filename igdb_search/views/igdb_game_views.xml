<?xml version="1.0"?>
<odoo>
    <record id="action_igdb_games" model="ir.actions.act_window">
        <field name="name">Games</field>
        <field name="path">games</field>
        <field name="res_model">igdb.game</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
    <record id="igdb_game_view_form" model="ir.ui.view">
        <field name="name">igdb.game.form</field>
        <field name="model">igdb.game</field>
        <field name="arch" type="xml">
            <form edit="0">
                <header>
                    <button name="get_cover" string="Get Cover" type="object" display="always"/>
                </header>
                <sheet class="o_igdb_form_sheet_bg">
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="igdb_id"/>
                            <field name="first_release_date"/>
                            <field name="url" widget="url"/>
                            <field name="platform_ids" options="{'no_create': True}" widget="many2many_tags"/>
                            <field name="genre_ids" options="{'no_create': True}" widget="many2many_tags"/>
                            <field name="theme_ids" options="{'no_create': True}" widget="many2many_tags"/>
                            <field name="perspective_ids" options="{'no_create': True}" widget="many2many_tags"/>
                            <field name="franchise_ids" options="{'no_create': True}" widget="many2many_tags"/>
                            <separator/>
                        </group>
                        <group>
                            <field name="game_cover" widget="image" invisible="0"/>
                        </group>
                        <group colspan="12">
                            <field name="query_ids" options="{'no_create': True}">
                                <list>
                                    <field name="name"/>
                                    <field name="concatenated_query"/>
                                    <field name="game_name"/>
                                    <field name="included_platform_ids" widget="many2many_tags"/>
                                    <field name="excluded_platform_ids" widget="many2many_tags"/>
                                    <field name="included_genre_ids" widget="many2many_tags"/>
                                    <field name="excluded_genre_ids" widget="many2many_tags"/>
                                    <field name="included_theme_ids" widget="many2many_tags"/>
                                    <field name="excluded_theme_ids" widget="many2many_tags"/>
                                    <field name="included_perspective_ids" widget="many2many_tags"/>
                                    <field name="excluded_perspective_ids" widget="many2many_tags"/>
                                    <field name="included_franchise_ids" widget="many2many_tags"/>
                                    <field name="excluded_franchise_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </group>
                    </group>
                    <notebook>
                        <page name="developers" string="Developers">
                            <field name="developer_ids"/>
                        </page>
                        <page name="publishers" string="Publishers">
                            <field name="publisher_ids"/>
                        </page>
                        <page name="porters" string="Porters">
                            <field name="porter_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="igdb_game_view_list" model="ir.ui.view">
        <field name="name">igdb.game.list</field>
        <field name="model">igdb.game</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="get_cover" string="Get Covers" type="object" display="always"/>
                </header>
                <field name="name"/>
                <field name="igdb_id" optional="hide"/>
                <field name="first_release_date"/>
                <field name="platform_ids" widget="many2many_tags"/>
                <field name="genre_ids" widget="many2many_tags"/>
                <field name="theme_ids" widget="many2many_tags"/>
                <field name="perspective_ids" widget="many2many_tags"/>
                <field name="developer_ids" widget="many2many_tags" optional="show"/>
                <field name="publisher_ids" widget="many2many_tags" optional="show"/>
                <field name="franchise_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="igdb_game_view_kanban" model="ir.ui.view">
        <field name="name">igdb.game.kanban</field>
        <field name="model">igdb.game</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="game_cover" widget="image" class="d-block position-relative"/>
                        </aside>
                        <main class="ms-2">
                            <field name="name"/>
                            <field name="platform_ids" widget="many2many_tags"/>
                            <field name="developer_ids" widget="many2many_tags"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>