<?xml version="1.0"?>
<odoo>
    <record id="action_igdb_queries" model="ir.actions.act_window">
        <field name="name">Queries</field>
        <field name="path">queries</field>
        <field name="res_model">igdb.query</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="igdb_query_view_form" model="ir.ui.view">
        <field name="name">igdb.query.form</field>
        <field name="model">igdb.query</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="do_search" string="Do Search" type="object"/>
                </header>
                <sheet class="o_igdb_form_sheet_bg">
                    <group>
                        <group string="Name and Query">
                            <field name="name"/>
                            <field name="concatenated_query"/>
                            <field name="where_clause_used" invisible="1"/>
                            <field name="game_name"/>
                            <field name="num_game_limit"/>
                        </group>
                        <group string="Release Date">
                            <field name="release_date_start"/>
                            <field name="release_date_end"/>
                        </group>
                        <group string="Inclusive and Exclusive Filters">
                            <group style="border-right: 1px solid lightgrey;">
                                <label for="included_platform_ids"/>
                                <div class="d-inline-flex">
                                    <field name="included_platform_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="is_exclusive_platform" nolabel="1"/>
                                </div>
                                <field name="included_genre_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="included_theme_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="included_perspective_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="included_franchise_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="included_developer_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="included_publisher_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            </group>
                            <group>
                                <label for="excluded_platform_ids"/>
                                <div>
                                    <field name="excluded_platform_ids" widget="many2many_tags" options="{'no_create': True}" readonly="is_exclusive_platform" invisible="is_exclusive_platform"/>
                                    <field name="excluded_platform_ids" widget="many2many_tags" options="{'no_create': True}" readonly="is_exclusive_platform" invisible="not is_exclusive_platform" style="visibility:hidden;"/>
                                </div>
                                <field name="excluded_genre_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="excluded_theme_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="excluded_perspective_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="excluded_franchise_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="excluded_developer_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="excluded_publisher_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            </group>
                        </group>
                        <group>

                        </group>
                        <notebook>
                            <page name="results_list" string="Search Results (list)">
                                <field name="result_game_ids" readonly="1" options="{'no_create': True}">
                                    <list>
                                        <field name="name"/>
                                        <field name="igdb_id" optional="hide"/>
                                        <field name="first_release_date"/>
                                        <field name="platform_ids" widget="many2many_tags"/>
                                        <field name="genre_ids" widget="many2many_tags"/>
                                        <field name="theme_ids" widget="many2many_tags"/>
                                        <field name="perspective_ids" widget="many2many_tags"/>
                                        <field name="developer_ids" widget="many2many_tags" optional="show"/>
                                        <field name="publisher_ids" widget="many2many_tags" optional="show"/>
                                        <field name="franchise_ids" widget="many2many_tags"/>
                                    </list>
                                </field>
                            </page>
                            <page name="results_kanban" string="Search Results (kanban)">
                                <group>
                                    <button string="Get All Covers" class="btn btn-primary" name="get_result_covers" type="object" context="{'get_all_covers': True}"/>
                                    <button string="Get New Covers" class="btn" name="get_result_covers" type="object" context="{'get_all_covers': False}"/>
                                </group>
                                <field name="result_game_ids" readonly="1" options="{'no_create': True}">
                                    <kanban>
                                        <templates>
                                            <t t-name="card" class="flex-row">
                                                <aside class="o_kanban_aside_full">
                                                    <field name="game_cover" widget="image" class="d-block position-relative"/>
                                                </aside>
                                                <main class="ms-2">
                                                    <field name="name"/>
                                                    <field name="platform_ids" widget="many2many_tags"/>
                                                    <hr class="my-0"/>
                                                    <field name="developer_ids" widget="many2many_tags"/>
                                                </main>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </page>
                        </notebook>
                        <field name="search_completed"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="igdb_query_view_list" model="ir.ui.view">
        <field name="name">igdb.query.list</field>
        <field name="model">igdb.query</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="concatenated_query"/>
                <field name="where_clause_used" column_invisible="1"/>
                <field name="num_game_limit" column_invisible="1"/>
                <field name="game_name"/>
                <field name="release_date_start"/>
                <field name="release_date_end"/>
                <field name="included_platform_ids" widget="many2many_tags"/>
                <field name="excluded_platform_ids" widget="many2many_tags"/>
                <field name="included_genre_ids" widget="many2many_tags"/>
                <field name="excluded_genre_ids" widget="many2many_tags"/>
                <field name="included_theme_ids" widget="many2many_tags"/>
                <field name="excluded_theme_ids" widget="many2many_tags"/>
                <field name="included_perspective_ids" widget="many2many_tags"/>
                <field name="excluded_perspective_ids" widget="many2many_tags"/>
                <field name="included_developer_ids" widget="many2many_tags"/>
                <field name="excluded_developer_ids" widget="many2many_tags"/>
                <field name="included_publisher_ids" widget="many2many_tags"/>
                <field name="excluded_publisher_ids" widget="many2many_tags"/>
                <field name="included_franchise_ids" widget="many2many_tags"/>
                <field name="excluded_franchise_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
</odoo>